+// API instants must carry a timezone. Date-only values use DateTime.parse separately.
+DateTime parseApiInstant(Object? value) {
+  final text = value?.toString() ?? '';
+  if (!RegExp(r'(Z|[+-]\d{2}:\d{2})$', caseSensitive: false).hasMatch(text)) {
